# Docker Compose 根目录环境变量
# 复制为 .env 后填写真实值；.env 不会进仓库。

# MySQL 容器账号密码（backend 的 DATABASE_URL 由 compose 用它拼出来）
MYSQL_PASSWORD=pawcare_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# 端口：数据库 / Redis / 后端只绑定 127.0.0.1，前端对外。
# 本地 8080 起浏览器；服务器改成 80 即可直接访问。
MYSQL_PORT=3307
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=8080

# 国内服务器构建镜像时用（服务器上取消注释即可）：
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# 登录页是否展示演示账号一键填入；正式对外时设为 false
# （这是前端构建参数，改完要重新 build frontend）
VITE_DEMO_ACCOUNTS=true

# 后端会从 backend/.env 读取其余变量；这里只放 compose 需要的。
