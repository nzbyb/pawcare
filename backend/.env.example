# ============================================================
# PawCare 后端环境变量模板
# 复制为 backend/.env 后填写真实值；.env 不进仓库。
# ============================================================

# ---------- 数据库 ----------
# 本地 MySQL（默认 3306）：先建库和账号，再跑 alembic upgrade head
#   CREATE DATABASE pawcare CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'pawcare'@'localhost' IDENTIFIED BY '你的密码';
#   GRANT ALL PRIVILEGES ON pawcare.* TO 'pawcare'@'localhost';
#   GRANT ALL PRIVILEGES ON `pawcare_eval`.* TO 'pawcare'@'localhost';  -- 评测库
#   FLUSH PRIVILEGES;
# 若用 docker compose 里的 MySQL，宿主机端口是 3307。
DATABASE_URL=mysql+pymysql://pawcare:your_password@127.0.0.1:3306/pawcare?charset=utf8mb4

# ---------- JWT ----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please_generate_a_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 大模型（OpenAI 兼容） ----------
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Redis / 限流 ----------
# 留空 = 进程内存限流；Docker 部署时由 compose 注入 redis://redis:6379/0
REDIS_URL=

# ---------- 定时任务 ----------
# 每天 08:00 扫描健康提醒并补站内通知；测试环境关闭。
SCHEDULER_ENABLED=true

# ---------- Agent ----------
# explicit = 显式工具调用循环（默认、生产主实现）
# langgraph = 对照实验适配层，需要先装 requirements-agent.txt
AGENT_ENGINE=explicit
AI_MAX_CONCURRENCY=3
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# ---------- RAG ----------
# 向量以 JSON 文本存 MySQL，检索在应用层计算余弦相似度。
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CACHE_DIR=.fastembed_cache
RAG_TOP_K=3
RAG_MIN_SCORE=0.45

# ---------- 上传 ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---------- 邮箱 / 短信验证码 ----------
# 邮箱走 SMTP 授权码（不是登录密码）：
#   QQ 邮箱：smtp.qq.com / 465 / SSL，在“设置-账户”开启 SMTP 后生成授权码
#   163 邮箱：smtp.163.com / 465 / SSL，同样使用客户端授权码
# 四项都填了才会真正发信；否则仅在 VERIFY_CODE_DEBUG=true 时打印到日志。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# 手机短信发送器：console = 只写日志（本地演示）；接入阿里云/腾讯云后在此扩展。
SMS_PROVIDER=console

# 验证码策略
VERIFY_CODE_TTL_SECONDS=300
VERIFY_CODE_RESEND_SECONDS=60
VERIFY_CODE_HOURLY_LIMIT=5
VERIFY_CODE_MAX_ATTEMPTS=5

# 开启后接口会直接返回 debug_code，只允许本地使用，部署必须为 false。
VERIFY_CODE_DEBUG=false

# 登录保护：连续失败 5 次锁定 15 分钟
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 支付 ----------
# 当前为模拟收银台：二维码指向 PAYMENT_MOCK_BASE_URL 下的 /pay/<支付单号>。
# 换前端端口或域名时同步修改，否则扫码打不开。
PAYMENT_TTL_MINUTES=15
PAYMENT_MOCK_BASE_URL=http://localhost:5173
