# ============================================================
# PawCare 后端环境变量模板
# 复制为 backend/.env 后填写真实值；.env 不进仓库。
# ============================================================

# ---------- 数据库 ----------
# 本地 MySQL（默认 3306）：先建库和账号，再跑 alembic upgrade head
#   CREATE DATABASE pawcare CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'pawcare'@'localhost' IDENTIFIED BY '你的密码';
#   GRANT ALL PRIVILEGES ON pawcare.* TO 'pawcare'@'localhost';
#   GRANT ALL PRIVILEGES ON `pawcare_eval`.* TO 'pawcare'@'localhost';  -- 评测库
#   FLUSH PRIVILEGES;
# 若用 docker compose 里的 MySQL，宿主机端口是 3307。
DATABASE_URL=mysql+pymysql://pawcare:your_password@127.0.0.1:3306/pawcare?charset=utf8mb4

# ---------- JWT ----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please_generate_a_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 大模型（OpenAI 兼容） ----------
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Redis / 限流 ----------
# 留空 = 进程内存限流；Docker 部署时由 compose 注入 redis://redis:6379/0
REDIS_URL=

# ---------- 定时任务 ----------
# 每天 08:00 扫描健康提醒并补站内通知；测试环境关闭。
SCHEDULER_ENABLED=true

# ---------- Agent ----------
# explicit = 显式工具调用循环（默认、生产主实现）
# langgraph = 对照实验适配层，需要先装 requirements-agent.txt
AGENT_ENGINE=explicit
AI_MAX_CONCURRENCY=3
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# ---------- MCP Server（对外提供能力） ----------
# MCP Server 单次工具调用超时（秒）。
# stdio 模式的 PAWCARE_MCP_TOKEN 由客户端启动时注入环境变量，不写入本文件。
MCP_TOOL_TIMEOUT_SECONDS=5
# 每个用户每分钟的 MCP HTTP 请求上限；0 表示关闭。部署时建议配合 REDIS_URL。
MCP_RATE_LIMIT_PER_MINUTE=60
# 是否把每次 MCP 调用写入 mcp_audit_logs（管理端 /api/admin/mcp-audit 可查）。
MCP_AUDIT_ENABLED=true

# ---------- MCP Client（站内 Agent 接入外部 Server） ----------
# JSON 数组；留空时 Agent 只使用本地 8 个工具。env / headers 支持 ${VAR} 展开，
# token 放在环境变量里，不要直接写进这行配置。
# 示例（接入本项目的只读 Server，stdio 会为每次发现/调用单独拉起进程）：
# MCP_CLIENT_SERVERS=[{"name":"pawcare","transport":"stdio","command":"python","args":["-m","app.mcp.server","--transport","stdio"],"env":{"PAWCARE_MCP_TOKEN":"${PAWCARE_MCP_TOKEN}"}}]
# 远程示例：
# MCP_CLIENT_SERVERS=[{"name":"remote","transport":"streamable-http","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ${REMOTE_MCP_TOKEN}"}}]
MCP_CLIENT_SERVERS=
MCP_CLIENT_DISCOVERY_TIMEOUT_SECONDS=3
MCP_CLIENT_CALL_TIMEOUT_SECONDS=8
MCP_CLIENT_CACHE_SECONDS=300

# ---------- RAG ----------
# 向量以 JSON 文本存 MySQL，检索在应用层计算余弦相似度。
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CACHE_DIR=.fastembed_cache
RAG_TOP_K=3
RAG_MIN_SCORE=0.45

# ---------- 上传 ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---------- 邮箱 / 短信验证码 ----------
# 邮箱走 SMTP 授权码（不是登录密码）：
#   QQ 邮箱：smtp.qq.com / 465 / SSL，在“设置-账户”开启 SMTP 后生成授权码
#   163 邮箱：smtp.163.com / 465 / SSL，同样使用客户端授权码
# 四项都填了才会真正发信；否则仅在 VERIFY_CODE_DEBUG=true 时打印到日志。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# 手机短信发送器：console = 只写日志（本地演示）；接入阿里云/腾讯云后在此扩展。
SMS_PROVIDER=console

# 验证码策略
VERIFY_CODE_TTL_SECONDS=300
VERIFY_CODE_RESEND_SECONDS=60
VERIFY_CODE_HOURLY_LIMIT=5
VERIFY_CODE_MAX_ATTEMPTS=5

# 开启后接口会直接返回 debug_code，只允许本地使用，部署必须为 false。
VERIFY_CODE_DEBUG=false

# 登录保护：连续失败 5 次锁定 15 分钟
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 支付 ----------
# mock：本地模拟收银台（默认，不产生真实资金）；
# alipay：支付宝沙箱 / 正式环境的电脑网站支付。
PAYMENT_PROVIDER=mock
PAYMENT_TTL_MINUTES=15
# 前端地址：模拟收银台链接和支付宝同步跳转都回到这里。
# 换前端端口或域名时同步修改，否则扫码 / 回跳打不开。
PAYMENT_MOCK_BASE_URL=http://localhost:5173
# 后端公网地址：用于拼支付宝异步通知地址。本地联调支付宝需填内网穿透地址。
PUBLIC_BASE_URL=http://localhost:8000

# --- 支付宝（申请沙箱后填写；密钥不要提交到仓库）---
# 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式网关：https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
# 填文件路径（推荐）或一整段 PEM；路径相对于启动目录。
# 应用私钥由支付宝密钥工具生成；支付宝公钥在沙箱控制台复制。
ALIPAY_PRIVATE_KEY=secrets/alipay_app_private.pem
ALIPAY_PUBLIC_KEY=secrets/alipay_public.pem
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 留空时自动用 PUBLIC_BASE_URL + /api/payments/alipay/notify。
ALIPAY_NOTIFY_URL=
# 可选：校验通知里的收款账号（沙箱为沙箱买家对应的卖家 UID）。
ALIPAY_SELLER_ID=
ALIPAY_QUERY_TIMEOUT_SECONDS=5.0
