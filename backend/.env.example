# ============================================================
# PawCare 后端环境变量模板
# 复制为 backend/.env 后填写真实值；.env 不进仓库。
# ============================================================

# ---------- 数据库 ----------
# 本地开发可先用 SQLite：sqlite:///./pawcare_dev.db
# 生产 / Docker：postgresql+psycopg://pawcare:密码@127.0.0.1:5432/pawcare
DATABASE_URL=postgresql+psycopg://pawcare:your_password@127.0.0.1:5432/pawcare

# ---------- JWT ----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please_generate_a_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 大模型（OpenAI 兼容） ----------
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Redis / 限流 ----------
# 留空 = 进程内存限流；Docker 部署时由 compose 注入 redis://redis:6379/0
REDIS_URL=

# ---------- Agent ----------
AI_MAX_CONCURRENCY=3
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# ---------- RAG ----------
# 本地用 fastembed + SQLite；模型缓存目录不入库。
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CACHE_DIR=.fastembed_cache
RAG_TOP_K=3
RAG_MIN_SCORE=0.45

# ---------- 上传 ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
